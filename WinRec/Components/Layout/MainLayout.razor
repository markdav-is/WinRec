        <div class="header-brand">
            <span class="brand-icon">&#9210;</span>
            <span class="brand-name">WIN<span class="brand-accent">REC</span></span>
        </div>
        <div class="header-tagline text-label">Moon Base Alpha · Audio Recording System</div>
